{
  "env": {
    "name": "real_robot",
    "fps": 30,
    "robot": {
      "type": "piper_follower",
      "port": "left_piper",
      "max_relative_target": null,
      "cameras": {
        "wrist1": {
          "type": "intelrealsense",
          "serial_number_or_name": "234322305361",
          "fps": 30,
          "width": 640,
          "height": 480
        },
        "topdown": {
          "type": "intelrealsense",
          "serial_number_or_name": "213522251124",
          "fps": 30,
          "width": 640,
          "height": 480
        }
      }
    },
    "teleop": {
      "type": "piper_gamepad_6dof",
      "use_gripper": true
    },
    "processor": {
      "control_mode": "gamepad",
      "observation": {
        "add_ee_pose_to_observation": true,
        "display_cameras": true
      },
      "gripper": {
        "use_gripper": true,
        "gripper_penalty": 0.0
      },
      "reset": {
        "fixed_reset_joint_positions": [0.0, 0.993, -0.893, 0.0, 1.22, 0.0, 0.07],
        "reset_time_s": 2.0,
        "control_time_s": 30.0,
        "terminate_on_success": true
      },
      "inverse_kinematics": {
        "urdf_path": "URDF/Piper/piper_description.urdf",
        "target_frame_name": "ee",
        "end_effector_bounds": {
          "min": [0.0, -0.45, -0.15],
          "max": [0.55, 0.45, 0.5]
        },
        "end_effector_step_sizes": {
          "x": 0.008,
          "y": 0.008,
          "z": 0.008
        }
      },
      "max_gripper_pos": 0.07
    }
  },
  "dataset": {
    "repo_id": "piper/hilserl_pet_demos",
    "task": "pet",
    "num_episodes_to_record": 10,
    "push_to_hub": false
  },
  "mode": "record",
  "device": "cpu"
}
