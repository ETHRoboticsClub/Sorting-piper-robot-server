{
  "env": {
    "name": "real_robot",
    "fps": 30,
    "robot": {
      "type": "piper_follower",
      "port": "left_piper",
      "max_relative_target": null,
      "cameras": {}
    },
    "teleop": {
      "type": "piper_gamepad_6dof",
      "use_gripper": true
    },
    "processor": {
      "control_mode": "gamepad",
      "gripper": {
        "use_gripper": true,
        "gripper_penalty": 0.0
      },
      "reset": {
        "fixed_reset_joint_positions": [0.0, 0.993, -0.893, 0.0, 1.22, 0.0, 0.07],
        "reset_time_s": 2.0,
        "control_time_s": 120.0,
        "terminate_on_success": true
      },
      "inverse_kinematics": {
        "urdf_path": "URDF/Piper/piper_description.urdf",
        "target_frame_name": "ee",
        "end_effector_bounds": {
          "min": [-0.3, -0.65, -0.15],
          "max": [0.75, 0.65, 0.5]
        },
        "end_effector_step_sizes": {
          "x": 0.008,
          "y": 0.008,
          "z": 0.008
        }
      },
      "max_gripper_pos": 0.07
    }
  },
  "dataset": {
    "repo_id": "piper/hilserl_teleop_test",
    "task": "teleop smoke test",
    "num_episodes_to_record": 100,
    "push_to_hub": false
  },
  "mode": null,
  "device": "cpu"
}
